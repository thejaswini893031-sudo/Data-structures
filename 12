
#include <stdio.h>
#define SIZE 50

struct Student
{
    char name[30];
    int rollno;
    int sub[3];
};

int main()
{
    int i, j, max, total, n, a[SIZE], ni = 0;
    struct Student st[SIZE];

    printf("Enter how many students: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++)
    {
        printf("\nEnter name and roll number for student %d: ", i);
        scanf("%29s", st[i].name);
        scanf("%d", &st[i].rollno);
    }

    for (i = 0; i < n; i++)
    {
        for (j = 0; j < 3; j++)
        {
            printf("Enter marks of student %d for subject %d: ", i, j);
            scanf("%d", &st[i].sub[j]);
        }
    }

    for (i = 0; i < n; i++)
    {
        total = 0;

        for (j = 0; j < 3; j++)
            total += st[i].sub[j];

        printf("\nTotal marks obtained by student %s are %d\n",
               st[i].name, total);
        a[i] = total;
    }

    for (j = 0; j < 3; j++)
    {
        max = -1;

        for (i = 0; i < n; i++)
        {
            if (max < st[i].sub[j])
            {
                max = st[i].sub[j];
                ni = i;
            }
        }

        printf("Student %s got maximum marks = %d in Subject: %d\n",
               st[ni].name, max, j);
    }

    max = -1;

    for (i = 0; i < n; i++)
    {
        if (max < a[i])
        {
            max = a[i];
            ni = i;
        }
    }

    printf("%s obtained the total highest marks.\n", st[ni].name);

    return 0;
}

