#include <stdio.h>
#define MAX_SIZE 100

int main() {
    int a[MAX_SIZE], n, i, choice, x, pos, found;

    n = 0;

    while (1) {
        printf("\n1.Create  2.Insert  3.Search");
        printf("\n4.Delete  5.Display  6.Exit");
        printf("\nEnter choice: ");
        scanf("%d", &choice);

        if (choice == 1) {
            printf("Enter number of elements: ");
            scanf("%d", &n);
            printf("Enter elements: ");
            for (i = 0; i < n; i++)
                scanf("%d", &a[i]);
        }
        else if (choice == 2) {
            printf("Enter element and position: ");
            scanf("%d%d", &x, &pos);

            if (n < MAX_SIZE && pos >= 0 && pos <= n) {
                for (i = n; i > pos; i--)
                    a[i] = a[i - 1];
                a[pos] = x;
                n++;
                printf("Element inserted\n");
            }
        }
        else if (choice == 3) {
            printf("Enter element to search: ");
            scanf("%d", &x);
            found = -1;

            for (i = 0; i < n; i++)
                if (a[i] == x) {
                    found = i;
                    break;
                }

            if (found == -1)
                printf("Element not found\n");
            else
                printf("Element found at position: %d\n", found);
        }
        else if (choice == 4) {
            printf("Enter position to delete: ");
            scanf("%d", &pos);

            if (pos >= 0 && pos < n) {
                for (i = pos; i < n - 1; i++)
                    a[i] = a[i + 1];
                n--;
                printf("Element deleted\n");
            }
        }
        else if (choice == 5) {
            printf("Array elements: ");
            for (i = 0; i < n; i++)
                printf("%d ", a[i]);
            printf("\n");
        }
        else if (choice == 6) {
            break;
        }
    }
